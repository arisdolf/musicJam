# Frontend: leave blank for local development (Vite proxies /api and /ws).
# In production, set these in the Vercel project environment.
VITE_API_URL=
VITE_ROOM_SERVER_URL=
VITE_YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Backend: set these in Render environment variables (not VITE_ prefixed).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=https://your-vercel-app.vercel.app
PORT=3001
